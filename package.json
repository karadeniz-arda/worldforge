{
  "name": "worldforge",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript playground for autonomous agents in simulated worlds.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "benchmark": "tsx src/benchmark-cli.ts",
    "benchmark:validate": "tsx src/benchmark-cli.ts --validate",
    "generate": "tsx src/generate-cli.ts",
    "replay": "tsx src/replay-cli.ts",
    "planning:compare": "tsx src/planning-comparison-cli.ts",
    "experiment:005": "tsx src/experiment-005-cli.ts",
    "experiment:006": "tsx src/experiment-006-cli.ts",
    "experiment:006d": "tsx src/experiment-006d-cli.ts",
    "benchmark:procedural": "tsx src/procedural-benchmark-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
